# 로컬 개발용 값의 이름만 둔다. 실제 값은 .env 에 넣고 커밋하지 않는다.
POSTGRES_USER=broker
POSTGRES_PASSWORD=broker
POSTGRES_DB=broker
POSTGRES_PORT=5434
DATABASE_URL=postgresql+psycopg://broker:broker@localhost:5434/broker

REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

OPA_PORT=8181
OPA_URL=http://localhost:8181

# 데모 에이전트용 LLM 키 (브로커 자체는 LLM을 쓰지 않는다)
OPENAI_API_KEY=
